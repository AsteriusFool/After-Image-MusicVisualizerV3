{
  "name": "music-visualizer",
  "version": "1.0.0",
  "description": "Universal music visualizer — system audio loopback + FFT + WebGL shaders",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server.js",
    "postinstall": "node scripts/postinstall.js",
    "dev": "set NODE_ENV=development&& electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.musicvisualizer.app",
    "productName": "Music Visualizer",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!node_modules/**/*"
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
